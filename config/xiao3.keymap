#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1                         &kp N2               &kp N3                   &kp N4       &kp N5    &kp N6       &kp N7    &kp N8     &kp N9    &kp N0  &mt LA(BACKSPACE) BACKSPACE
&kp TAB    &mt SINGLE_QUOTE SINGLE_QUOTE  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt LG(P) P  &kp Y     &mt LG(F) F  &kp G     &kp C      &kp R     &kp L   &mt LS(SLASH) SLASH
&kp LSHFT  &kp A                          &kp O                &kp E                    &kp U        &kp I     &kp D        &kp H     &kp T      &kp N     &kp S   &mt LS(MINUS) MINUS
&kp LCTRL  &mt COLON SEMICOLON            &kp Q                &kp J                    &kp K        &kp X     &kp B        &kp M     &kp W      &kp V     &kp Z   &kp BSLH
                                                                                        &kp BSPC                            &sl 1
                                          &kp LEFT_GUI         &kp LEFT_SHIFT           &kp LALT     &mo 1     &mo 2        &kp RALT  &kp SPACE  &kp RGUI
            >;
        };

        layer_1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans                         &trans          &trans        &trans                           &trans  &trans
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &trans                         &trans          &trans        &trans                           &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &mt LA(LEFT_ARROW) LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &mt LG(RIGHT_ARROW) RIGHT_ARROW  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans                         &trans          &trans        &trans                           &trans  &trans
                                                      &trans                                                       &bootloader
                          &trans        &trans        &trans        &trans          &trans                         &trans          &trans        &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F7  &kp F8       &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans  &trans   &trans   &kp ENTER
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans  &trans   &trans   &trans
                                &trans                    &bootloader
                &trans  &trans  &trans  &trans    &trans  &trans       &trans  &trans
            >;
        };
    };
};
