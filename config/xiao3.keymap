#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp N1                         &kp N2               &kp N3                   &kp N4          &kp N5           &kp N6          &kp N7     &kp N8                    &kp N9  &kp N0  &mt LA(BACKSPACE) BACKSPACE
&kp TAB     &mt SINGLE_QUOTE SINGLE_QUOTE  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt LG(P) P     &kp Y            &mt LG(F) F     &kp G      &kp C                     &kp R   &kp L   &mt LS(SLASH) SLASH
&kp ESCAPE  &kp A                          &kp O                &kp E                    &kp U           &kp I            &kp D           &kp H      &kp T                     &kp N   &kp S   &mt LS(MINUS) MINUS
&kp LCTRL   &mt COLON SEMICOLON            &kp Q                &kp J                    &kp K           &kp X            &kp B           &kp M      &kp W                     &kp V   &kp Z   &kp BSLH
                                                                                         &mkp LCLK                                        &mkp RCLK
                                           &kp RIGHT_ALT        &kp LGUI                 &kp LEFT_SHIFT  &kp BACKSPACE    &sk LEFT_SHIFT  &mo 1      &hold_tap LEFT_GUI SPACE  &mo 2
            >;
        };

        layer_1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans                         &trans          &trans        &trans                           &trans                 &trans
&kp TAB     &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET                      &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS             &kp RIGHT_PARENTHESIS  &trans
&trans      &trans           &trans        &trans        &kp EQUAL     &kp GRAVE       &mt LA(LEFT_ARROW) LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &mt LA(RIGHT_ARROW) RIGHT_ARROW  &kp QUESTION           &kp ENTER
&trans      &trans           &trans        &trans        &kp PLUS      &kp TILDE       &kp PIPE                       &trans          &trans        &trans                           &trans                 &trans
                                                         &trans                                                       &trans
                             &trans        &trans        &trans        &trans          &trans                         &trans          &trans        &trans
            >;
        };

        layer_2 {
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans    &trans         &trans          &trans           &trans            &trans             &trans
&trans       &trans  &trans  &trans  &trans  &trans    &kp NUMBER_6   &kp N7          &kp N8           &kp N9            &kp N0             &kp F12
&trans       &trans  &trans  &trans  &trans  &trans    &kp NUMBER_1   &kp NUMBER_2    &kp NUMBER_3     &kp NUMBER_4      &kp N5             &kp ENTER
&bootloader  &trans  &trans  &trans  &trans  &trans    &kp BACKSLASH  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
                                     &trans                           &bootloader
                     &trans  &trans  &trans  &trans    &trans         &trans          &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                &trans                    &trans
                &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
